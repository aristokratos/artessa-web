# Public — shipped to the browser. Never put a secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:5080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client id. The *secret* lives only in the API — the browser
# never sees it, because the API owns the authorization-code exchange.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Paystack public key. Only needed if inline/popup checkout is ever adopted;
# v1 uses the hosted redirect flow and does not need this at all.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Used by `npm run api:types` to regenerate src/types/api.d.ts from the
# backend's OpenAPI document.
ARTESSA_API_URL=http://localhost:5080
