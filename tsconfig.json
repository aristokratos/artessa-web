{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // The service worker is checked by tsconfig.sw.json instead. lib.dom and
  // lib.webworker declare conflicting globals (self, fetch, EventTarget, ...),
  // so they cannot share one config — and the worker needs webworker for
  // ServiceWorkerGlobalScope. `npm run typecheck` runs both.
  "exclude": ["node_modules", "src/app/sw.ts"]
}
