{
  // Type-checks the Serwist service worker only. Serwist bundles src/app/sw.ts
  // itself at build time; this config exists so the file is still type-checked
  // and so editors resolve worker globals inside it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "webworker"],
    "types": []
  },
  "include": ["src/app/sw.ts"],
  "exclude": []
}
